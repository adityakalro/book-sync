[Unit]
Description=Book Sync private manual sync page
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=book-sync
Group=book-sync
WorkingDirectory=/opt/book-sync
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/book-sync/.venv/bin/python /opt/book-sync/sync_page.py
Restart=on-failure
RestartSec=10
UMask=0077
Nice=10
IOSchedulingClass=idle
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
