[Unit]
Description=Book Sync automatic Kindle and Readest onboarding
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=book-sync
Group=book-sync
WorkingDirectory=/opt/book-sync
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/book-sync/.venv/bin/python -m book_sync.sync.onboarding --watch --interval 300
Restart=on-failure
RestartSec=30
UMask=0077
Nice=10
IOSchedulingClass=idle
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
