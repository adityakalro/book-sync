[Unit]
Description=Placekeeper automatic Kindle and Readest onboarding
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=placekeeper
Group=placekeeper
WorkingDirectory=/opt/placekeeper
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/placekeeper/.venv/bin/python -m placekeeper.sync.onboarding --watch --interval 300
Restart=on-failure
RestartSec=30
UMask=0077
Nice=10
IOSchedulingClass=idle
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
